	for rows.Next() {
		var id string
		var atNs int64
		var dataBytes []byte
		if err := rows.Scan(&id, &atNs, &dataBytes); err != nil {
			if closeErr := rt.CloseRows(rows, "select"); closeErr != nil {
				return nil, fmt.Errorf("scan row from %s: %w (additionally, %v)", ChoiceTableName, err, closeErr)
			}
			return nil, fmt.Errorf("scan row from %s: %w", ChoiceTableName, err)
		}
		data := &Choice{}
		if err := proto.Unmarshal(dataBytes, data); err != nil {
			if closeErr := rt.CloseRows(rows, "select"); closeErr != nil {
				return nil, fmt.Errorf("unmarshal Choice row: %w (additionally, %v)", err, closeErr)
			}
			return nil, fmt.Errorf("unmarshal Choice row: %w", err)
		}
		result = append(result, ChoiceRow{ID: id, AtNs: atNs, Data: data})
	}
	if err := rows.Err(); err != nil {
		if closeErr := rt.CloseRows(rows, "select"); closeErr != nil {
			return nil, fmt.Errorf("iterate rows from %s: %w (additionally, %v)", ChoiceTableName, err, closeErr)
		}
		return nil, fmt.Errorf("iterate rows from %s: %w", ChoiceTableName, err)
	}
	if err := rt.CloseRows(rows, "select"); err != nil {
		return nil, err
	}
	return result, nil
}

func (t *ChoiceTable) Insert(data *Choice) (ChoiceRow, error) {
	if t.q == nil {
		return ChoiceRow{}, errors.New("nil DBTX")
	}
	if data == nil {
		return ChoiceRow{}, errors.New("nil data")
	}
	id, err := rt.UUIDv7()
	if err != nil {
		return ChoiceRow{}, fmt.Errorf("generate uuidv7: %w", err)
	}
	if err := rt.ValidateUUIDv7(id); err != nil {
		return ChoiceRow{}, fmt.Errorf("validate generated id %s: %w", id, err)
	}
	return t.insertWithID(id, data)
}

func (t *ChoiceTable) insertWithID(id string, data *Choice) (ChoiceRow, error) {
	if t.q == nil {
		return ChoiceRow{}, errors.New("nil DBTX")
	}
	if data == nil {
		return ChoiceRow{}, errors.New("nil data")
	}
	if id == "" {
		return ChoiceRow{}, errors.New("empty id")
	}
	if err := rt.ValidateUUIDv7(id); err != nil {
		return ChoiceRow{}, fmt.Errorf("validate id %s: %w", id, err)
	}
	atNs, err := rt.WriteLocalObjectContext(context.Background(), t.q, ChoiceGeneratedBinding, id, data, true)
	if err != nil {
		return ChoiceRow{}, err
	}
	return ChoiceRow{ID: id, AtNs: atNs, Data: data}, nil
}

func (t *ChoiceTable) UpdateByID(id string, data *Choice) (ChoiceRow, error) {
	if t.q == nil {
		return ChoiceRow{}, errors.New("nil DBTX")
	}
	if id == "" {
		return ChoiceRow{}, errors.New("empty id")
	}
	if err := rt.ValidateUUIDv7(id); err != nil {
		return ChoiceRow{}, fmt.Errorf("validate id %s: %w", id, err)
	}
	if data == nil {
		return ChoiceRow{}, errors.New("nil data")
	}
	atNs, err := rt.WriteLocalObjectContext(context.Background(), t.q, ChoiceGeneratedBinding, id, data, false)
	if err != nil {
		return ChoiceRow{}, err
	}
	return ChoiceRow{ID: id, AtNs: atNs, Data: data}, nil
}

func (t *ChoiceTable) UpdateRow(row ChoiceRow) (ChoiceRow, error) {
	if t.q == nil {
		return ChoiceRow{}, errors.New("nil DBTX")
	}
	if row.ID == "" {
		return ChoiceRow{}, errors.New("empty id")
	}
	if row.Data == nil {
		return ChoiceRow{}, errors.New("nil data")
	}
	return t.UpdateByID(row.ID, row.Data)
}

func (t *ChoiceTable) DeleteByID(id string) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if id == "" {
		return errors.New("empty id")
	}
	return rt.DeleteLocalBoundObjectContext(context.Background(), t.q, ChoiceGeneratedBinding, id)
}

func (t *ChoiceTable) DeleteRow(row ChoiceRow) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if row.ID == "" {
		return errors.New("empty id")
	}
	return t.DeleteByID(row.ID)
}

func (t *ChoiceTable) upsertWithAtNs(id string, atNs int64, data *Choice) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if id == "" {
		return errors.New("empty id")
	}
	if data == nil {
		return errors.New("nil data")
	}
	dataJSON, err := rt.MarshalAnyJSON(data)
	if err != nil {
		return err
	}
	return t.q.WithTransaction(context.Background(), func(tx rt.DBTX) error {
		return rt.ApplyIncomingObjectContext(context.Background(), tx, ChoiceGeneratedBinding, rt.JSONLRecord{ID: id, AtNs: atNs, Data: dataJSON})
	})
}

func (t *ChoiceTable) tombstoneWithAtNs(id string, atNs int64) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if id == "" {
		return errors.New("empty id")
	}
	dataJSON, err := rt.MarshalTypeOnlyAnyJSON(ChoiceTypeName)
	if err != nil {
		return err
	}
	return t.q.WithTransaction(context.Background(), func(tx rt.DBTX) error {
		return rt.ApplyIncomingObjectContext(context.Background(), tx, ChoiceGeneratedBinding, rt.JSONLRecord{ID: id, Deleted: true, AtNs: atNs, Data: dataJSON})
	})
}

func (t *ChoiceTable) drainUnknownRows(typeName string) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if typeName == "" {
		return errors.New("empty type name")
	}
	return rt.DrainUnknownBindingsContext(context.Background(), t.q, []rt.GeneratedTableBinding{ChoiceGeneratedBinding})
}

func (t *ChoiceTable) DrainUnknownRows() error {
	return t.drainUnknownRows(ChoiceTypeName)
}

type CRUD struct {
	Person *PersonTable
	Note   *NoteTable
	Choice *ChoiceTable
}

var crudGeneratedBindings = []rt.GeneratedTableBinding{
	PersonGeneratedBinding,
	NoteGeneratedBinding,
	ChoiceGeneratedBinding,
}

func NewCRUD(q DBTX) *CRUD {
	q = rt.WithChangeListeners(q)
	return &CRUD{
		Person: NewPersonTable(q),
		Note:   NewNoteTable(q),
		Choice: NewChoiceTable(q),
	}
}

func (c *CRUD) TableDescriptors() []rt.GeneratedTableDescriptor {
	descriptors := make([]rt.GeneratedTableDescriptor, 0, len(crudGeneratedBindings)+len(rt.CoreTableDescriptors()))
	for _, binding := range crudGeneratedBindings {
		descriptors = append(descriptors, binding.Descriptor)
	}
	return append(descriptors, rt.CoreTableDescriptors()...)
}

func (c *CRUD) dbtx() (DBTX, error) {
	if c == nil {
		return nil, errors.New("nil CRUD")
	}
	if c.Person != nil && c.Person.q != nil {
		return c.Person.q, nil
	}
	if c.Note != nil && c.Note.q != nil {
		return c.Note.q, nil
	}
	if c.Choice != nil && c.Choice.q != nil {
		return c.Choice.q, nil
	}
	return nil, errors.New("nil DBTX")
}

func (c *CRUD) Init() error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	if err := rt.EnsureCoreTables(q); err != nil {
		return err
	}
	if err := c.Person.init(false); err != nil {
		return fmt.Errorf("init Person table: %w", err)
	}
	if err := c.Note.init(false); err != nil {
		return fmt.Errorf("init Note table: %w", err)
	}
	if err := c.Choice.init(false); err != nil {
		return fmt.Errorf("init Choice table: %w", err)
	}
	return rt.DrainUnknownBindingsContext(context.Background(), q, crudGeneratedBindings)
}

func (c *CRUD) WriteJSONL(remote string, w io.Writer) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.WriteBoundJSONLContext(context.Background(), q, crudGeneratedBindings, remote, w)
}

func (c *CRUD) PrepareJSONL(remote string, w io.Writer) (rt.JSONLCheckpoint, error) {
	q, err := c.dbtx()
	if err != nil {
		return rt.JSONLCheckpoint{}, err
	}
	return rt.PrepareBoundJSONLContext(context.Background(), q, crudGeneratedBindings, remote, w)
}

func (c *CRUD) AcknowledgeJSONL(checkpoint rt.JSONLCheckpoint) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.AcknowledgeJSONLContext(context.Background(), q, checkpoint)
}

func (c *CRUD) DiscardJSONL(checkpoint rt.JSONLCheckpoint) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.DiscardJSONLContext(context.Background(), q, checkpoint)
}

func (c *CRUD) ReadJSONL(remote string, r io.Reader) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.ReadBoundJSONLContext(context.Background(), q, crudGeneratedBindings, remote, r)
}
