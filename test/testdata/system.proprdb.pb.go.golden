	if row.Data == nil {
		return NoteRow{}, errors.New("nil data")
	}
	return t.UpdateByID(row.ID, row.Data)
}

func (t *NoteTable) DeleteByID(id string) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if id == "" {
		return errors.New("empty id")
	}
	return rt.DeleteLocalBoundObjectContext(context.Background(), t.q, NoteGeneratedBinding, id)
}

func (t *NoteTable) DeleteRow(row NoteRow) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if row.ID == "" {
		return errors.New("empty id")
	}
	return t.DeleteByID(row.ID)
}

func (t *NoteTable) Changes(ctx context.Context) (<-chan NoteChange, error) {
	if t.q == nil {
		return nil, errors.New("nil DBTX")
	}
	return rt.TableChanges[*Note](ctx, t.q, NoteTableName)
}

func (t *NoteTable) upsertWithAtNs(id string, atNs int64, data *Note) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if id == "" {
		return errors.New("empty id")
	}
	if data == nil {
		return errors.New("nil data")
	}
	dataJSON, err := rt.MarshalAnyJSON(data)
	if err != nil {
		return err
	}
	return t.q.WithTransaction(context.Background(), func(tx rt.DBTX) error {
		return rt.ApplyIncomingObjectContext(context.Background(), tx, NoteGeneratedBinding, rt.JSONLRecord{ID: id, AtNs: atNs, Data: dataJSON})
	})
}

func (t *NoteTable) tombstoneWithAtNs(id string, atNs int64) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if id == "" {
		return errors.New("empty id")
	}
	dataJSON, err := rt.MarshalTypeOnlyAnyJSON(NoteTypeName)
	if err != nil {
		return err
	}
	return t.q.WithTransaction(context.Background(), func(tx rt.DBTX) error {
		return rt.ApplyIncomingObjectContext(context.Background(), tx, NoteGeneratedBinding, rt.JSONLRecord{ID: id, Deleted: true, AtNs: atNs, Data: dataJSON})
	})
}

func (t *NoteTable) reproject() error {
	ctx := context.Background()
	rows, err := t.q.QueryContext(ctx, `SELECT id, data FROM "`+NoteTableName+`"`)
	if err != nil {
		return fmt.Errorf("query rows for reprojection: %w", err)
	}
	type reprojectRow struct {
		id        string
		dataBytes []byte
	}
	rowBuffer := make([]reprojectRow, 0)
	for rows.Next() {
		var id string
		var dataBytes []byte
		if err := rows.Scan(&id, &dataBytes); err != nil {
			return fmt.Errorf("scan reprojection row: %w", err)
		}
		copiedData := make([]byte, len(dataBytes))
		copy(copiedData, dataBytes)
		rowBuffer = append(rowBuffer, reprojectRow{id: id, dataBytes: copiedData})
	}
	if err := rows.Err(); err != nil {
		return fmt.Errorf("iterate reprojection rows: %w", err)
	}
	if err := rows.Close(); err != nil {
		return fmt.Errorf("close reprojection rows: %w", err)
	}
	for _, row := range rowBuffer {
		data := &Note{}
		if err := proto.Unmarshal(row.dataBytes, data); err != nil {
			return fmt.Errorf("unmarshal reprojection row: %w", err)
		}
		reprojectArgs := []any{}
		reprojectArgs = append(reprojectArgs, data.GetText())
		reprojectArgs = append(reprojectArgs, row.id)
		if _, err := t.q.ExecContext(ctx, NoteReprojectSQL, reprojectArgs...); err != nil {
			return fmt.Errorf("reproject row %s: %w", row.id, err)
		}
	}
	return nil
}

func (t *NoteTable) drainUnknownRows(typeName string) error {
	if t.q == nil {
		return errors.New("nil DBTX")
	}
	if typeName == "" {
		return errors.New("empty type name")
	}
	return rt.DrainUnknownBindingsContext(context.Background(), t.q, []rt.GeneratedTableBinding{NoteGeneratedBinding})
}

func (t *NoteTable) DrainUnknownRows() error {
	return t.drainUnknownRows(NoteTypeName)
}

type CRUD struct {
	Person *PersonTable
	Note   *NoteTable
}

var crudGeneratedBindings = []rt.GeneratedTableBinding{
	PersonGeneratedBinding,
	NoteGeneratedBinding,
}

func NewCRUD(q DBTX) *CRUD {
	q = rt.WithChangeListeners(q)
	return &CRUD{
		Person: NewPersonTable(q),
		Note:   NewNoteTable(q),
	}
}

func (c *CRUD) TableDescriptors() []rt.GeneratedTableDescriptor {
	descriptors := make([]rt.GeneratedTableDescriptor, 0, len(crudGeneratedBindings)+len(rt.CoreTableDescriptors()))
	for _, binding := range crudGeneratedBindings {
		descriptors = append(descriptors, binding.Descriptor)
	}
	return append(descriptors, rt.CoreTableDescriptors()...)
}

func (c *CRUD) dbtx() (DBTX, error) {
	if c == nil {
		return nil, errors.New("nil CRUD")
	}
	if c.Person != nil && c.Person.q != nil {
		return c.Person.q, nil
	}
	if c.Note != nil && c.Note.q != nil {
		return c.Note.q, nil
	}
	return nil, errors.New("nil DBTX")
}

func (c *CRUD) Init() error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	if err := rt.EnsureCoreTables(q); err != nil {
		return err
	}
	if err := c.Person.init(false); err != nil {
		return fmt.Errorf("init Person table: %w", err)
	}
	if err := c.Note.init(false); err != nil {
		return fmt.Errorf("init Note table: %w", err)
	}
	return rt.DrainUnknownBindingsContext(context.Background(), q, crudGeneratedBindings)
}

func (c *CRUD) WriteJSONL(remote string, w io.Writer) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.WriteBoundJSONLContext(context.Background(), q, crudGeneratedBindings, remote, w)
}

func (c *CRUD) PrepareJSONL(remote string, w io.Writer) (rt.JSONLCheckpoint, error) {
	q, err := c.dbtx()
	if err != nil {
		return rt.JSONLCheckpoint{}, err
	}
	return rt.PrepareBoundJSONLContext(context.Background(), q, crudGeneratedBindings, remote, w)
}

func (c *CRUD) AcknowledgeJSONL(checkpoint rt.JSONLCheckpoint) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.AcknowledgeJSONLContext(context.Background(), q, checkpoint)
}

func (c *CRUD) DiscardJSONL(checkpoint rt.JSONLCheckpoint) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.DiscardJSONLContext(context.Background(), q, checkpoint)
}

func (c *CRUD) ReadJSONL(remote string, r io.Reader) error {
	q, err := c.dbtx()
	if err != nil {
		return err
	}
	return rt.ReadBoundJSONLContext(context.Background(), q, crudGeneratedBindings, remote, r)
}
